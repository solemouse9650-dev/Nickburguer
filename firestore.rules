rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validShortString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function createdOrder(orderId) {
      return validShortString(orderId, 128)
        && existsAfter(/databases/$(database)/documents/orders/$(orderId))
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.id == orderId;
    }

    function validCheckoutItem(item) {
      return item is map
        && validShortString(item.get('productId', ''), 128)
        && item.get('quantity', 0) is int
        && item.get('quantity', 0) >= 1
        && item.get('quantity', 0) <= 20
        && item.get('unitPrice', -1) is number
        && item.get('unitPrice', -1) >= 0
        && item.get('unitPrice', -1) <= 1000000;
    }

    function validItemAt(items, index) {
      return items.size() <= index || validCheckoutItem(items[index]);
    }

    function itemTotalAt(items, index) {
      return items.size() <= index
        ? 0.0
        : items[index].get('unitPrice', 0) * items[index].get('quantity', 0);
    }

    // Totales consistentes sin get() por producto (evita límite de expresiones).
    function validOrderAmounts() {
      let items = request.resource.data.items;
      let expectedSubtotal = itemTotalAt(items, 0)
        + itemTotalAt(items, 1)
        + itemTotalAt(items, 2)
        + itemTotalAt(items, 3)
        + itemTotalAt(items, 4)
        + itemTotalAt(items, 5)
        + itemTotalAt(items, 6)
        + itemTotalAt(items, 7)
        + itemTotalAt(items, 8)
        + itemTotalAt(items, 9)
        + itemTotalAt(items, 10)
        + itemTotalAt(items, 11)
        + itemTotalAt(items, 12)
        + itemTotalAt(items, 13)
        + itemTotalAt(items, 14)
        + itemTotalAt(items, 15)
        + itemTotalAt(items, 16)
        + itemTotalAt(items, 17)
        + itemTotalAt(items, 18)
        + itemTotalAt(items, 19);
      return request.resource.data.get('subtotal', -1) is number
        && request.resource.data.subtotal == expectedSubtotal
        && request.resource.data.get('deliveryCost', -1) is number
        && request.resource.data.deliveryCost >= 0
        && request.resource.data.deliveryCost <= 100000
        && request.resource.data.get('discount', -1) is number
        && request.resource.data.discount >= 0
        && request.resource.data.discount <= expectedSubtotal
        && request.resource.data.total
          == expectedSubtotal + request.resource.data.deliveryCost - request.resource.data.discount;
    }

    function couponMatchesCreatedOrder(couponId) {
      let orderId = request.resource.data.get('lastOrderId', '');
      return createdOrder(orderId)
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.get('couponId', '')
          == couponId;
    }

    function customerMatchesCreatedOrder(customerId) {
      let orderId = request.resource.data.get('lastOrderId', '');
      return createdOrder(orderId)
        && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.phone == customerId;
    }

    // UID bootstrap (primer admin). Solo puede crear/actualizar SU propio doc con role=admin.
    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.uid == 'cm50EaIxcgdzWhb1XEsuo6PVkzN2';
    }

    function validBootstrapAdminProfile() {
      return request.resource.data.role == 'admin'
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 320;
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (
        isBootstrapAdmin()
        && request.auth.uid == userId
        && validBootstrapAdminProfile()
      );
      allow update: if isAdmin() || (
        isBootstrapAdmin()
        && request.auth.uid == userId
        && resource.data.role == 'admin'
        && validBootstrapAdminProfile()
      );
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'usedCount', 'lastOrderId', 'updatedAt'
        ])
        && request.resource.data.usedCount is number
        && request.resource.data.usedCount == resource.data.get('usedCount', 0) + 1
        && resource.data.get('active', true) == true
        && (
          !('maxUses' in resource.data)
          || resource.data.maxUses == null
          || request.resource.data.usedCount <= resource.data.maxUses
        )
        && couponMatchesCreatedOrder(couponId)
      );
    }

    match /business_settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.status in ['pendiente', 'nuevo']
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total <= 100000000
        && validShortString(request.resource.data.orderNumber, 40)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{8,15}$')
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 20
        && validItemAt(request.resource.data.items, 0)
        && validItemAt(request.resource.data.items, 1)
        && validItemAt(request.resource.data.items, 2)
        && validItemAt(request.resource.data.items, 3)
        && validItemAt(request.resource.data.items, 4)
        && validItemAt(request.resource.data.items, 5)
        && validItemAt(request.resource.data.items, 6)
        && validItemAt(request.resource.data.items, 7)
        && validItemAt(request.resource.data.items, 8)
        && validItemAt(request.resource.data.items, 9)
        && validItemAt(request.resource.data.items, 10)
        && validItemAt(request.resource.data.items, 11)
        && validItemAt(request.resource.data.items, 12)
        && validItemAt(request.resource.data.items, 13)
        && validItemAt(request.resource.data.items, 14)
        && validItemAt(request.resource.data.items, 15)
        && validItemAt(request.resource.data.items, 16)
        && validItemAt(request.resource.data.items, 17)
        && validItemAt(request.resource.data.items, 18)
        && validItemAt(request.resource.data.items, 19)
        && validOrderAmounts()
        && validShortString(request.resource.data.get('firstName', ''), 80)
        && validShortString(request.resource.data.get('lastName', ''), 80)
        && request.resource.data.get('email', '') is string
        && request.resource.data.get('email', '').size() <= 160
        && request.resource.data.get('notes', '') is string
        && request.resource.data.get('notes', '').size() <= 1000
      );
      allow update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || (
        request.resource.data.phone is string
        && request.resource.data.phone == customerId
        && request.resource.data.phone.matches('^[0-9]{8,15}$')
        && request.resource.data.totalSpent is number
        && request.resource.data.totalSpent >= 0
        && request.resource.data.totalSpent <= 100000000
        && customerMatchesCreatedOrder(customerId)
      );
      allow update: if isAdmin() || (
        request.resource.data.phone == resource.data.phone
        && request.resource.data.phone == customerId
        && request.resource.data.totalOrders is number
        && request.resource.data.totalSpent is number
        && request.resource.data.totalSpent >= resource.data.get('totalSpent', 0)
        && customerMatchesCreatedOrder(customerId)
      );
      allow delete: if isAdmin();
    }

    match /counters/{counterId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /reservations/{reservationId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'phone', 'date', 'time', 'guests', 'notes', 'status',
          'source', 'createdAt', 'updatedAt'
        ])
        && validShortString(request.resource.data.name, 100)
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{8,15}$')
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.time is string
        && request.resource.data.time.matches('^[0-9]{2}:[0-9]{2}$')
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1
        && request.resource.data.guests <= 20
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.status == 'pendiente'
        && request.resource.data.source == 'web';
    }
  }
}
